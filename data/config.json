{
    "app": {
        "name": "Sistem Absensi dengan Pendeteksi Wajah",
        "window_size": [
            1024,
            768
        ]
    },
    "database": {
        "path": "data/database.db"
    },
    "face_recognition": {
        "tolerance": 0.6,
        "model": "hog",
        "detection_frequency": 3
    },
    "camera": {
        "default_source": "webcam",
        "default_resolution": [
            640,
            480
        ],
        "saved_cameras": []
    },
    "attendance": {
        "auto_check_out": true,
        "notification_enabled": true
    }
}